[Unit]
Description=Telusko backend (FastAPI)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/labbox/backend
EnvironmentFile=/opt/labbox/backend/.env
# One worker only: the check lock and the idle reaper live in memory.
ExecStart=/opt/labbox/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
