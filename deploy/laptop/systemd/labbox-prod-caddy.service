# The live site's web server: the built frontend, and /api, /ws, /preview, /ide to the backend.
[Unit]
Description=LabBox live web server (Caddy, port 8180)
After=labbox-prod.service

[Service]
ExecStart=%h/.local/bin/caddy run --adapter caddyfile --config /srv/labbox/prod/current/deploy/laptop/Caddyfile
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
