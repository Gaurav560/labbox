# Comments must be on their own line: systemd EnvironmentFile does not strip inline comments.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
LABS_DIR=../labs
# On Mac/Windows dev, use a folder Docker Desktop can share, e.g. ~/labbox-volumes
VOLUMES_DIR=/srv/labbox/volumes
# Temporary copies used by Check (one folder per run, deleted afterwards)
CHECKS_DIR=/srv/labbox/checks
DATABASE_URL=sqlite:///./data/labbox.db
# Empty = default runc. Set to runsc on EC2 once gVisor is installed.
CONTAINER_RUNTIME=
IDLE_STOP_MINUTES=15
REAPER_INTERVAL_SECONDS=60
MAX_FILE_BYTES=1000000
CORS_ORIGINS=http://localhost:5173
ALLOW_SIGNUP=true

# Optional: free Pexels API key, only used by `scripts/labbox cover` to find stock photos for lab cards.
PEXELS_API_KEY=
# Optional: Gemini API key, only used by `scripts/labbox cover --generate` (AI cover art, paid per image).
GEMINI_API_KEY=
